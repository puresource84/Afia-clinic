<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_itcs_license_apply_code_wizard_form" model="ir.ui.view">
        <field name="name">itcs.license.apply.code.wizard.form</field>
        <field name="model">itcs.license.apply.code.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Renewal Code">
                <group>
                    <field name="license_id" readonly="1"/>
                    <field name="code" placeholder="AFIA-XXXX-XXXX-XXXX-XXXX"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
