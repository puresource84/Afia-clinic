<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_dental_patient" model="ir.sequence">
        <field name="name">Dental Patient No.</field>
        <field name="code">dental.patient</field>
        <field name="prefix">PAT/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_dental_appointment" model="ir.sequence">
        <field name="name">Dental Appointment No.</field>
        <field name="code">dental.appointment</field>
        <field name="prefix">APT/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_dental_prescriptions" model="ir.sequence">
        <field name="name">Dental Prescription No.</field>
        <field name="code">dental.prescriptions</field>
        <field name="prefix">RX/</field>
        <field name="padding">5</field>
    </record>
</odoo>
