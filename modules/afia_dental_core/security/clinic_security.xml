<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="clinic_category" model="ir.module.category">
            <field name="name">Clinic</field>
            <field name="description">Category for Clinic modules</field>
            <field name="sequence">30</field>
        </record>

        <!-- Order matters: a group may only imply one already defined above it,
             so the chain is declared bottom-up (receptionist, dentist, admin).

             2026-10-30: this is now the ONE set of clinic roles. A second,
             parallel set (group_clinic_admin / _dentist / _reception) used
             to live in security_groups.xml, and different modules pointed
             their ACLs at different sets - two groups both called
             "Receptionist", with different permissions, both assignable from
             the same screen. The retired set carried an implication chain
             (manager -> dentist -> reception) that this one did not, so the
             chain is reproduced here: unifying must not take access away
             from anyone who held the retired role. -->


        <record id="group_clinic_receptionist" model="res.groups">
            <field name="name">Clinic Receptionist</field>
            <field name="category_id" ref="afia_dental_core.clinic_category"/>
            <!-- base.group_user: a clinic role is useless without internal-user
                 access - without it the holder cannot even read
                 mail.message.subtype, so creating any chattered record fails. -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_clinic_dentist" model="res.groups">
            <field name="name">Clinic Dentist</field>
            <field name="category_id" ref="afia_dental_core.clinic_category"/>
            <field name="implied_ids" eval="[(4, ref('group_clinic_receptionist'))]"/>
        </record>

        <record id="group_clinic_admin" model="res.groups">
            <field name="name">Clinic Administrator</field>
            <field name="category_id" ref="afia_dental_core.clinic_category"/>
            <field name="implied_ids" eval="[(4, ref('group_clinic_dentist'))]"/>
        </record>
    </data>

    <!-- Moved here 2026-10-30 from dental_charting / dental_clinical_permissions.
         Security groups are foundational: every module references them, so a group
         defined above the base forces an upward dependency. Keeping all five clinic
         roles in core is what keeps the dependency graph acyclic. -->
    <record id="group_dental_clinician" model="res.groups">
        <field name="name">Dental Clinician</field>
        <field name="comment">Dentists/hygienists: may create and edit clinical tooth records. Reception stays read-only.</field>
    </record>

    <record id="group_clinic_hygienist" model="res.groups">
        <field name="name">Clinic Hygienist</field>
        <field name="category_id" ref="afia_dental_core.clinic_category"/>
        <field name="comment">May edit charting and questionnaires; cannot prescribe or edit treatment plans.</field>
        <field name="implied_ids" eval="[
            (4, ref('afia_dental_core.group_dental_clinician')),
            (4, ref('base.group_user')),
        ]"/>
    </record>
</odoo>