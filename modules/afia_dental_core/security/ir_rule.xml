<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- New: dental.appointment now carries company_id natively, so
         multi-branch record separation is a first-class core feature
         instead of being retrofitted by dental_branch later. -->
    <record id="rule_dental_appointment_company" model="ir.rule">
        <field name="name">Dental Appointment: multi-company</field>
        <field name="model_id" ref="model_dental_appointment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
