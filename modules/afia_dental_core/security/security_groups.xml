<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dental" model="ir.module.category">
        <field name="name">Afia Dental Clinic</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_dental_reception" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="category_id" ref="module_category_dental"/>
        <field name="comment">Books/manages appointments and patients; no clinical record access.</field>
    </record>

    <record id="group_dental_dentist" model="res.groups">
        <field name="name">Dentist</field>
        <field name="category_id" ref="module_category_dental"/>
        <field name="implied_ids" eval="[(4, ref('group_dental_reception'))]"/>
        <field name="comment">Full clinical record access for their own patients/appointments.</field>
    </record>

    <record id="group_dental_manager" model="res.groups">
        <field name="name">Clinic Administrator</field>
        <field name="category_id" ref="module_category_dental"/>
        <field name="implied_ids" eval="[(4, ref('group_dental_dentist'))]"/>
        <field name="comment">Full access across all dentists/branches, including configuration.</field>
    </record>
</odoo>
