<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_dental" model="ir.ui.view">
        <field name="name">account.payment.form.dental</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="move_id" domain="[('partner_id', '=', partner_id), ('is_treatment_invoice', '=', True)]"/>
                <field name="treatment_name" readonly="1"/>
                <field name="amount_due" widget="monetary" readonly="1"/>
                <field name="patient_sign"/>
            </xpath>
        </field>
    </record>

    <!-- Top-level Invoices / Payments menus (Afia Dental Clinic app) -->
    <record id="action_dental_invoices" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('partner_id.is_patient', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_is_treatment_invoice': True}</field>
    </record>

    <record id="action_dental_payments" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_id.is_patient', '=', True)]</field>
        <field name="context">{'search_default_inbound_filter': 1}</field>
    </record>
</odoo>
