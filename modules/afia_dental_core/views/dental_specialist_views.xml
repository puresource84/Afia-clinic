<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_specialist_list" model="ir.ui.view">
        <field name="name">dental.specialist.list</field>
        <field name="model">dental.specialist</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <record id="action_dental_specialist" model="ir.actions.act_window">
        <field name="name">Specialties</field>
        <field name="res_model">dental.specialist</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
