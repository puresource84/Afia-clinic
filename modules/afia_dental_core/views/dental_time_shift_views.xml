<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_time_shift_list" model="ir.ui.view">
        <field name="name">dental.time.shift.list</field>
        <field name="model">dental.time.shift</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="shift_type"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="name" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="action_dental_time_shift" model="ir.actions.act_window">
        <field name="name">Time Shifts</field>
        <field name="res_model">dental.time.shift</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
