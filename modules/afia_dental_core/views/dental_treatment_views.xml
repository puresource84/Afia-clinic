<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dental_treatment_view_tree" model="ir.ui.view">
        <field name="name">dental.treatment.list</field>
        <field name="model">dental.treatment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="treatment_categ_id"/>
                <field name="cost" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_dental_treatment_form" model="ir.ui.view">
        <field name="name">dental.treatment.form</field>
        <field name="model">dental.treatment</field>
        <field name="arch" type="xml">
            <form string="Treatment">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="treatment_categ_id"/>
                        <field name="cost" widget="monetary"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="dental_treatment_menu_action" model="ir.actions.act_window">
        <field name="name">Treatments</field>
        <field name="res_model">dental.treatment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
