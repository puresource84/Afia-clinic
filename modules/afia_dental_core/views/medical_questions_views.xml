<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medical_questions_list" model="ir.ui.view">
        <field name="name">medical.questions.list</field>
        <field name="model">medical.questions</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="question"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_medical_questions" model="ir.actions.act_window">
        <field name="name">Medical Questions</field>
        <field name="res_model">medical.questions</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
