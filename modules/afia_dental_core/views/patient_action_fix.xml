<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Fix: Patient records redirect to Invoicing in Odoo 18 ─────────────
         Root cause: Odoo 18 routes res.partner records through the Accounting
         module when account is installed, so bookmarked patient URLs like
         /odoo/accounting/partners/123 land inside Invoicing instead of the
         Dental Clinic app.

         Fix: assign a dedicated URL path "patients" to the Patients action so
         Odoo 18's client-side router maps it to /odoo/patients and
         /odoo/patients/123 — completely separate from Accounting's partner path.

         After upgrading dental_ux_fixes, existing bookmarks to /odoo/.../123
         will still work because the form_view_id on the action ensures the
         correct dental form view is used when the record is opened from the
         Patients list.
    ──────────────────────────────────────────────────────────────────────── -->
    <record id="afia_dental_core.dental_patient_menu" model="ir.actions.act_window">
        <field name="path">patients</field>
    </record>
</odoo>
