<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_teeth_chart_form" model="ir.ui.view">
        <field name="name">teeth.chart.form</field>
        <field name="model">teeth.chart</field>
        <field name="arch" type="xml">
            <form string="Teeth Chart (legacy)">
                <div class="alert alert-warning" role="alert">
                    Legacy flat chart. Use Dental Charting Pro's odontogram for new records.
                </div>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="selected_teeth" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_teeth_chart" model="ir.actions.act_window">
        <field name="name">Teeth Chart (legacy)</field>
        <field name="res_model">teeth.chart</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
