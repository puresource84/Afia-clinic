<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_doctor_invite_form" model="ir.ui.view">
        <field name="name">dental.doctor.invite.form</field>
        <field name="model">dental.doctor.invite</field>
        <field name="arch" type="xml">
            <form string="Grant System Access">
                <group invisible="state == 'done'">
                    <field name="employee_id" readonly="1"/>
                    <field name="login" placeholder="doctor@example.com or mobile number"/>
                    <field name="group_ids" widget="many2many_tags"/>
                </group>
                <div class="alert alert-success" role="alert" invisible="state != 'done'">
                    <p>Access granted. Login: <field name="login" readonly="1" nolabel="1"/></p>
                    <p>Temporary password (shown once — ask the doctor to change it immediately):</p>
                    <p><strong><field name="temp_password" readonly="1" nolabel="1"/></strong></p>
                    <p>If outgoing email is configured, a password-reset email was also sent.</p>
                </div>
                <footer>
                    <button name="action_grant_access" string="Grant Access" type="object"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
