<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_patient_group" name="Patient" parent="afia_dental_core.hospital_root_menu" sequence="20"/>
    <menuitem id="menu_billing_group" name="Billing" parent="afia_dental_core.hospital_root_menu" sequence="40"/>

    <record id="afia_dental_core.hospital_patient_info" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_patient_group"/>
        <field name="sequence">10</field>
    </record>
    <record id="afia_dental_core.dental_prescription_menu" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_patient_group"/>
        <field name="sequence">20</field>
        <field name="name">Prescriptions</field>
    </record>
    <record id="dental_treatment_plan.menu_dental_treatment_plans" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_patient_group"/>
        <field name="sequence">30</field>
    </record>
    <record id="dental_lab.menu_dental_lab" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_patient_group"/>
        <field name="sequence">40</field>
    </record>
    <record id="dental_consent.menu_consent_root" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_patient_group"/>
        <field name="sequence">50</field>
    </record>
    <record id="dental_sterilization.menu_dental_sterilization" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_patient_group"/>
        <field name="sequence">60</field>
    </record>

    <record id="afia_dental_core.hospital_invoice_info" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_billing_group"/>
        <field name="sequence">10</field>
    </record>
    <record id="afia_dental_core.hospital_payment_info" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_billing_group"/>
        <field name="sequence">20</field>
    </record>

    <record id="afia_dental_core.hospital_appointment_info" model="ir.ui.menu">
        <field name="parent_id" ref="afia_dental_core.hospital_root_menu"/>
        <field name="sequence">10</field>
    </record>
    <!-- afia_dental_core.dental_configure: duplicate re-parent removed 2026-10-30; the definitive
         record is in views/menu_quick_actions.xml, which loaded last and therefore won at runtime. -->
    <!-- ══════════════════════════════════════════════════════
         PATIENT KANBAN VIEW
         REF: ODOO18-PATIENT-KANBAN-026

         Model: res.partner (filtered to is_patient=True by action domain)
         Fields confirmed present on res.partner / DentalPatients:
           avatar_128   — base Odoo 18 image thumbnail
           patient_no   — custom Char (afia_dental_core)
           gender       — custom Selection male/female (afia_dental_core)
           patient_age  — custom Integer computed from dob (afia_dental_core)
           mobile       — base res.partner
           phone        — base res.partner
           city         — base res.partner
           email        — base res.partner
         ══════════════════════════════════════════════════════ -->
    <record id="view_partner_kanban_dental_patient" model="ir.ui.view">
        <field name="name">res.partner.kanban.dental.patient</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="avatar_128"/>
                <field name="patient_no"/>
                <field name="gender"/>
                <field name="patient_age"/>
                <field name="mobile"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="email"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="avatar_128" alt="Patient" class="w-100"
                                   widget="image"
                                   options="{'img_class': 'object-fit-cover'}"/>
                        </aside>
                        <main class="ps-2 ps-md-0">
                            <div class="mb-1">
                                <field name="name" class="fw-bold fs-6 mb-0"/>
                                <div t-if="record.patient_no.raw_value" class="text-muted small">
                                    <i class="fa fa-id-card-o me-1"/>
                                    <field name="patient_no"/>
                                </div>
                            </div>
                            <div t-if="record.gender.raw_value or record.patient_age.raw_value"
                                 class="d-flex gap-2 mb-1">
                                <span t-if="record.gender.raw_value" class="badge text-bg-info">
                                    <field name="gender"/>
                                </span>
                                <span t-if="record.patient_age.raw_value"
                                      class="badge text-bg-light border">
                                    <t t-esc="record.patient_age.value"/> yrs
                                </span>
                            </div>
                            <div t-if="record.mobile.raw_value or record.phone.raw_value"
                                 class="text-muted small">
                                <i class="fa fa-phone me-1"/>
                                <field t-if="record.mobile.raw_value" name="mobile"/>
                                <field t-elif="record.phone.raw_value" name="phone"/>
                            </div>
                            <div t-if="record.email.raw_value" class="text-muted small text-truncate">
                                <i class="fa fa-envelope me-1"/>
                                <field name="email"/>
                            </div>
                            <div t-if="record.city.raw_value" class="text-muted small">
                                <i class="fa fa-map-marker me-1"/>
                                <field name="city"/>
                            </div>
                            <footer><div/></footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Explicitly bind the patient kanban view to the Patients action.
         This prevents Odoo from falling back to the generic contacts kanban. -->
    <record id="act_window_view_patient_kanban" model="ir.actions.act_window.view">
        <field name="sequence">0</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_partner_kanban_dental_patient"/>
        <field name="act_window_id" ref="afia_dental_core.dental_patient_menu"/>
    </record>

    <!-- Update Patients action: add kanban as default (first) view mode -->
    <record id="afia_dental_core.dental_patient_menu" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>