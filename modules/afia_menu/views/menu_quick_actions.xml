<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- UX directives (Manhel, 2026-06-12), final form:
         1. Appointments page IS the quick-access point: calendar defaults to
            DAY view (today) and any slot click opens a compact quick-create
            dialog. No extra root menus.
         2. 5-item root structure: Appointments | Patients |
            Billing & Insurance | Reporting | Configuration.
         All records below mirror live changes applied via RPC with matching
         external IDs (no duplication on upgrade). -->

    <!-- Quick-create dialog used by the calendar -->
    <record id="view_appointment_quick_create" model="ir.ui.view">
        <field name="name">dental.appointment.quick.create</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <form string="New Appointment">
                <!-- 2026-09-13 fix: the calendar's date_start/date_stop point to
                     apt_start/apt_end (dental_appointment_times, priority 15).
                     Dragging a time range on the calendar sets
                     default_apt_start/default_apt_end in the new record's
                     context, but apt_start/apt_end were never fields on THIS
                     view — so the dragged range never reached the record, and
                     apt_start_time/apt_end_time (computed FROM apt_start/
                     apt_end) plus appointment_date (set by an onchange on
                     apt_start) all stayed blank/00:00. Adding them here
                     (invisible — the visible HH:MM/date fields below are what
                     staff actually edit) lets the drag-selected range land on
                     real fields so the existing compute/onchange chain fills
                     in the rest. -->
                <field name="apt_start" invisible="1"/>
                <field name="apt_end" invisible="1"/>
                <group>
                    <field name="patient_id"/>
                    <field name="dentist_id"/>
                    <field name="appointment_date"
                           options='{"datepicker": {"minDate": 0}}'/>
                </group>
                <group string="Time">
                    <field name="apt_start_time" widget="float_time_dropdown" required="1"/>
                    <field name="apt_end_time"   widget="float_time_dropdown" required="1"/>
                    <field name="apt_duration"   widget="float_time"          readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Permanently pin Patient Flow under Appointments (survives dental_patient_flow upgrades).
         Using <record> here is more robust than the <function> in menu_restructure.xml
         because it re-applies on every upgrade of dental_ux_fixes. -->
    <record id="dental_patient_flow.menu_patient_flow_board" model="ir.ui.menu">
        <field name="parent_id" ref="afia_dental_core.hospital_appointment_info"/>
        <field name="sequence">30</field>
    </record>

    <!-- Calendar: day view by default + slot-click quick create.
         quick_create_view_id needs a DB id inside the arch, which XML can't
         reference directly — the <function> below injects it portably. -->
    <record id="view_appointment_calendar_day_default" model="ir.ui.view">
        <field name="name">dental.appointment.calendar.day.default</field>
        <field name="model">dental.appointment</field>
        <field name="inherit_id" ref="afia_dental_core.view_dental_appointment_calendar"/>
        <field name="arch" type="xml">
            <calendar position="attributes">
                <attribute name="mode">day</attribute>
                <attribute name="quick_create">1</attribute>
            </calendar>
        </field>
    </record>
    <function model="ir.ui.view" name="write"
              eval="[[ref('view_appointment_calendar_day_default')],
                     {'arch_base': '&lt;data&gt;&lt;calendar position=\'attributes\'&gt;&lt;attribute name=\'mode\'&gt;day&lt;/attribute&gt;&lt;attribute name=\'quick_create\'&gt;1&lt;/attribute&gt;&lt;attribute name=\'quick_create_view_id\'&gt;%d&lt;/attribute&gt;&lt;/calendar&gt;&lt;/data&gt;' % ref('view_appointment_quick_create')}]"/>

    <!-- 5-item root structure -->
    <record id="afia_menu.menu_patient_group" model="ir.ui.menu">
        <field name="name">Patients</field>
    </record>
    <record id="dental_charting.menu_dental_tooth_record" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_patient_group"/>
        <field name="sequence">15</field>
    </record>
    <record id="afia_menu.menu_billing_group" model="ir.ui.menu">
        <field name="name">Billing &amp; Insurance</field>
    </record>
    <record id="dental_insurance.menu_insurers" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_billing_group"/>
        <field name="sequence">30</field>
    </record>
    <record id="dental_insurance.menu_policies" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_billing_group"/>
        <field name="sequence">40</field>
    </record>
    <record id="dental_insurance.menu_claims" model="ir.ui.menu">
        <field name="parent_id" ref="afia_menu.menu_billing_group"/>
        <field name="sequence">50</field>
    </record>
    <record id="dental_insurance.menu_insurance_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="dental_analytics.menu_dental_analytics" model="ir.ui.menu">
        <field name="name">Reporting</field>
    </record>
    <!-- dental_portal.menu_dental_book_link: duplicate re-parent removed 2026-10-30; the definitive
         record is in views/menu_configure_groups.xml, which loaded last and therefore won at runtime. -->
    <record id="afia_dental_core.dental_configure" model="ir.ui.menu">
        <field name="name">Configuration</field>
    </record>
</odoo>
