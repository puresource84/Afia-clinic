<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_clinic_core_res_config_settings" model="ir.ui.view">
            <field name="name">clinic.core.res.config.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Clinic Core" string="Clinic Core" name="clinic_core">
                        <block title="Clinic Core">
                            <setting string="Appointment Duration">
                                <field name="clinic_default_appointment_duration"/>
                            </setting>
                            <setting string="Grace Period">
                                <field name="clinic_appointment_grace_period"/>
                            </setting>
                            <setting string="Require Patient Mobile">
                                <field name="clinic_require_patient_mobile"/>
                            </setting>
                            <setting string="WhatsApp Reminders">
                                <field name="clinic_enable_whatsapp_reminders"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>