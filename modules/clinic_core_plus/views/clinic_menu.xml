<odoo>
    <!-- Inherit base settings form — adds Clinic Core Plus section without replacing it -->
    <record id="clinic_core_plus_settings_view" model="ir.ui.view">
        <field name="name">clinic.core.plus.res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Clinic Core Plus" string="Clinic Core Plus" name="clinic_core_plus">
                    <block title="Clinic Core Plus">
                        <setting string="Clinic Core Plus Settings">
                            <div class="text-muted">Manage clinic-level configurations here.</div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Action links to the standard Settings page -->
    <record id="clinic_core_plus_res_config_settings_action" model="ir.actions.act_window">
        <field name="name">Clinic Core Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="clinic_core_plus_res_config_settings_menu"
              name="Core Settings"
              parent="dental_hospital.dental_configure"
              action="clinic_core_plus_res_config_settings_action"
              groups="clinic_core_plus.group_clinic_admin"
              sequence="99"/>
</odoo>