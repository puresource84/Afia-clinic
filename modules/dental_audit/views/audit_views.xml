<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Appointment form: inject chatter (prescription already has <chatter/> built in) -->
    <record id="view_appointment_form_chatter" model="ir.ui.view">
        <field name="name">dental.appointment.form.chatter</field>
        <field name="model">dental.appointment</field>
        <field name="inherit_id" ref="afia_dental_core.view_dental_appointment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

</odoo>
