<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_branch_form" model="ir.ui.view">
        <field name="name">res.company.branch.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Branch Info" name="branch_info">
                    <group>
                        <field name="is_branch"/>
                        <field name="parent_clinic_id"
                            invisible="not is_branch"/>
                        <field name="branch_code"/>
                        <field name="branch_count"
                            invisible="is_branch"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>