<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_dental_chart_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            Dental Chart — <span t-field="doc.name"/>
                            <t t-if="doc.patient_no">
                                (<span t-field="doc.patient_no"/>)
                            </t>
                        </h2>
                        <p class="text-muted">
                            <span t-field="doc.phone"/>
                        </p>

                        <!-- Prints only the arch(es) actually charted for this patient
                             (adult, pediatric, or both for mixed dentition) — see
                             _dental_print_dentitions() in dental_chart_print.py. -->
                        <div class="row">
                            <t t-set="dentitions" t-value="doc._dental_print_dentitions()"/>
                            <t t-set="col_class" t-value="'col-6' if len(dentitions) &gt; 1 else 'col-12'"/>
                            <t t-foreach="dentitions" t-as="dent">
                                <div t-attf-class="#{col_class}" style="text-align: center; margin: 12px 0 16px 0;">
                                    <strong t-esc="dent['label']"/>
                                    <svg width="260" height="290" viewBox="0 0 300 340" xmlns="http://www.w3.org/2000/svg">
                                        <defs>
                                            <clipPath t-attf-id="dental_print_clip_circle_#{dent_index}" clipPathUnits="userSpaceOnUse">
                                                <circle cx="16" cy="16" r="16"/>
                                            </clipPath>
                                        </defs>
                                        <line x1="150" y1="10" x2="150" y2="330" stroke="#e0e0e0" stroke-width="0.75"/>
                                        <line x1="15" y1="170" x2="285" y2="170" stroke="#e0e0e0" stroke-width="0.75"/>
                                        <t t-foreach="dent['teeth']" t-as="rt">
                                            <g t-attf-transform="translate(#{rt['x'] - 16},#{rt['y'] - 16})">
                                                <g t-attf-clip-path="url(#dental_print_clip_circle_#{dent_index})">
                                                    <path d="M0,0 L32,0 L16,16 Z" t-attf-style="fill:#{rt['regions']['top']};stroke:#bdbdbd;stroke-width:0.5"/>
                                                    <path d="M32,0 L32,32 L16,16 Z" t-attf-style="fill:#{rt['regions']['right']};stroke:#bdbdbd;stroke-width:0.5"/>
                                                    <path d="M32,32 L0,32 L16,16 Z" t-attf-style="fill:#{rt['regions']['bottom']};stroke:#bdbdbd;stroke-width:0.5"/>
                                                    <path d="M0,32 L0,0 L16,16 Z" t-attf-style="fill:#{rt['regions']['left']};stroke:#bdbdbd;stroke-width:0.5"/>
                                                </g>
                                                <circle cx="16" cy="16" r="5" t-attf-style="fill:#{rt['regions']['center']};stroke:#bdbdbd;stroke-width:0.5"/>
                                                <circle cx="16" cy="16" r="16" fill="none" stroke="#757575" stroke-width="1"/>
                                                <text x="16" y="42" text-anchor="middle" font-size="8" font-family="sans-serif" fill="#616161" t-esc="rt['fdi']"/>
                                            </g>
                                        </t>
                                    </svg>
                                </div>
                            </t>
                        </div>

                        <div style="text-align: center; margin-bottom: 16px;">
                            <t t-foreach="doc._dental_print_legend()" t-as="entry">
                                <span style="display: inline-block; margin: 0 8px; font-size: 10px;">
                                    <span t-attf-style="display:inline-block;width:9px;height:9px;border:0.5px solid #bdbdbd;background:#{entry[2]};margin-right:3px;"/>
                                    <t t-esc="entry[1]"/>
                                </span>
                            </t>
                        </div>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Tooth</th>
                                    <th>Condition</th>
                                    <th>Surfaces</th>
                                    <th>Treatment</th>
                                    <th>Doctor</th>
                                    <th>Clinical Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.tooth_record_ids.filtered('is_current')" t-as="rec">
                                    <td><span t-field="rec.record_date"/></td>
                                    <td><span t-esc="rec.tooth_fdi"/></td>
                                    <td><span t-field="rec.condition"/></td>
                                    <td><span t-esc="rec.surfaces_label"/></td>
                                    <td><span t-field="rec.treatment_id"/></td>
                                    <td><span t-field="rec.doctor_id"/></td>
                                    <td><span t-field="rec.notes"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_dental_chart" model="ir.actions.report">
        <field name="name">Dental Chart</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dental_charting.report_dental_chart_document</field>
        <field name="report_file">dental_charting.report_dental_chart_document</field>
        <field name="print_report_name">'Dental Chart - %s%s' % (object.name, ' (%s)' % object.patient_no if object.patient_no else '')</field>
    </record>

</odoo>
