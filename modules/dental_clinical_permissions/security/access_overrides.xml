<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- NOW-bucket B1: demote the blanket base.group_user full-CRUD ACLs that
         ship in afia_dental_core / dental_treatment_plan / dental_consent CSVs
         to READ-ONLY. Write access comes back via the role ACLs in this
         module's own CSV.

         IMPORTANT (documented in manifest): upgrading those source modules
         reloads their CSVs and resets these rows to 1,1,1,1 — re-upgrade
         dental_clinical_permissions afterwards. -->

    <!-- afia_dental_core -->
    <record id="afia_dental_core.access_dental_prescription" model="ir.model.access">
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="afia_dental_core.access_dental_prescription_lines" model="ir.model.access">
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="afia_dental_core.access_medical_questionnaire" model="ir.model.access">
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="afia_dental_core.access_teeth_chart" model="ir.model.access">
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="afia_dental_core.access_xray_report" model="ir.model.access">
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="afia_dental_core.access_dental_treatment" model="ir.model.access">
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="afia_dental_core.access_treatment_category" model="ir.model.access">
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- dental_treatment_plan -->
    <record id="dental_treatment_plan.access_plan" model="ir.model.access">
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="dental_treatment_plan.access_plan_line" model="ir.model.access">
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- dental_consent: reception still prepares consent forms (create/write
         stays for internal users; signed forms locked by record rule), but
         templates become admin-managed and forms are no longer deletable by
         everyone. -->
    <record id="dental_consent.access_consent_tmpl" model="ir.model.access">
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="dental_consent.access_consent_form" model="ir.model.access">
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
