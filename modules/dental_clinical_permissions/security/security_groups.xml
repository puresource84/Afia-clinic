<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- NOW-bucket B1: clinical role matrix.
         clinic_core already ships Administrator / Dentist / Receptionist;
         we add Hygienist and wire the implication chain. -->


    <!-- Dentists are clinicians (tooth-record gate from dental_charting_pro).
         Also need base internal-user access plus Stock (Clinic Stock menu reads
         stock.move/stock.quant for consumable usage) — previously missing, which
         caused "not allowed to access Stock Move" errors for any non-admin role
         that opens Clinic Stock. -->
    <record id="afia_dental_core.group_clinic_dentist" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('afia_dental_core.group_dental_clinician')),
            (4, ref('base.group_user')),
            (4, ref('stock.group_stock_user')),
        ]"/>
    </record>

    <!-- Receptionist also touches Clinic Stock (dispensing/consumable lookups)
         and needs base internal-user access to use the system at all. -->
    <record id="afia_dental_core.group_clinic_receptionist" model="res.groups">
        <!-- base.group_partner_manager ("Contact Creation"): registering a
             walk-in patient creates a res.partner, which plain internal
             users are not allowed to do. -->
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_partner_manager')),
            (4, ref('stock.group_stock_user')),
        ]"/>
    </record>

    <!-- Clinic Administrator gets every clinic role, plus the base Odoo groups
         those roles were silently missing. Root cause of the two reported
         Access Errors: no clinic group implied base.group_user or any
         hr/stock/account group, so a user with ONLY the clinic group (e.g.
         added via Settings > Users rather than the clinic wizard) hit
         AccessError the moment a view touched hr.employee.public or
         stock.move. Admin additionally gets full HR access (needed for the
         commission report / employee dashboards on the Afia Clinic home
         screen) and base Invoicing access (Billing & Insurance menu is
         admin-only today). -->
    <record id="afia_dental_core.group_clinic_admin" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('afia_dental_core.group_clinic_dentist')),
            (4, ref('afia_dental_core.group_clinic_receptionist')),
            (4, ref('group_clinic_hygienist')),
            (4, ref('base.group_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('hr.group_hr_user')),
            (4, ref('account.group_account_invoice')),
        ]"/>
    </record>

    <!-- The admin user keeps working out of the box. -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('afia_dental_core.group_clinic_admin'))]"/>
    </record>

    <!-- Signed consent forms are immutable except for Clinic Administrators.
         Group rules OR together: admins match the second rule and bypass. -->
    <record id="rule_consent_form_signed_locked" model="ir.rule">
        <field name="name">Consent forms: signed forms are locked</field>
        <field name="model_id" ref="dental_consent.model_dental_consent_form"/>
        <field name="domain_force">[('state', '!=', 'signed')]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_consent_form_admin_bypass" model="ir.rule">
        <field name="name">Consent forms: clinic admin bypass</field>
        <field name="model_id" ref="dental_consent.model_dental_consent_form"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('afia_dental_core.group_clinic_admin'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
