<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consent_tmpl_list" model="ir.ui.view">
        <field name="name">dental.consent.template.list</field>
        <field name="model">dental.consent.template</field>
        <field name="arch" type="xml">
            <list><field name="name"/>
                <field name="procedure_type"/>
                <field name="requires_signature"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_consent_tmpl_form" model="ir.ui.view">
        <field name="name">dental.consent.template.form</field>
        <field name="model">dental.consent.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/><field name="procedure_type"/>
                        <field name="requires_signature"/><field name="active"/>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_consent_template" model="ir.actions.act_window">
        <field name="name">Consent Templates</field>
        <field name="res_model">dental.consent.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_consent_form_list" model="ir.ui.view">
        <field name="name">dental.consent.form.list</field>
        <field name="model">dental.consent.form</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'signed'"
                  decoration-danger="state == 'declined'">
                <field name="name"/><field name="patient_id"/>
                <field name="template_id"/><field name="appointment_id"/>
                <field name="signed_date"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'signed'"
                    decoration-warning="state == 'pending'"
                    decoration-danger="state == 'declined'"/>
            </list>
        </field>
    </record>
    <record id="view_consent_form_form" model="ir.ui.view">
        <field name="name">dental.consent.form.form</field>
        <field name="model">dental.consent.form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sign" type="object" string="Mark Signed"
                        invisible="state != 'pending'" class="btn-primary"/>
                    <button name="action_decline" type="object" string="Mark Declined"
                        invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="pending,signed"/>
                </header>
                <sheet>
                    <group><group>
                        <field name="name" readonly="1"/>
                        <field name="template_id"/>
                        <field name="patient_id"/>
                        <field name="appointment_id"/>
                        <field name="dentist_id"/>
                    </group><group>
                        <field name="signed_date"/>
                        <field name="signed_by"/>
                        <field name="witness_name"/>
                    </group></group>
                    <separator string="Consent Text"/>
                    <field name="consent_body" readonly="1"/>
                    <separator string="Patient Signature"/>
                    <field name="patient_signature" widget="image"
                        options="{'size': [400, 150]}"/>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_consent_form" model="ir.actions.act_window">
        <field name="name">Consent Forms</field>
        <field name="res_model">dental.consent.form</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>