<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════════════════════
             HISTORICAL — state=done — feeds the commission report pivot
             All dates are relative to install date so the data stays
             fresh after deployment.

             2026-08: switched from writing `appointment_date` directly to
             writing `start_datetime`. In the clean-room core, appointment_date
             is a compute-only field derived from start_datetime (backed by a
             real calendar.event) — it is no longer the source of truth.
             Writing appointment_date alone left start_datetime defaulting to
             "now" (the moment demo data loads) while appointment_date held
             the intended historical/future date, producing self-contradictory
             records (wrong calendar entries, mismatched dates) and breaking
             the commission report this data is meant to feed.
        ════════════════════════════════════════════════════════════════ -->

        <!-- Month −2: 4 done appointments -->
        <record id="apt_done_01" model="dental.appointment">
            <field name="patient_id" ref="patient_ali"/>
            <field name="dentist_id" ref="dentist_ahmed"/>
            <field name="start_datetime"
                   eval="(DateTime.now() - timedelta(days=65)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="treatments" eval="[(6, 0, [ref('dental_demo_data.treat_cleaning'), ref('dental_demo_data.treat_filling')])]"/>
            <field name="state">done</field>
        </record>
