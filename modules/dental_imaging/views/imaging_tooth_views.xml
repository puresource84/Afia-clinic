<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Add "Images" page to the Tooth Record form ──────────────────── -->
    <record id="view_tooth_record_imaging" model="ir.ui.view">
        <field name="name">dental.tooth.record.form.imaging</field>
        <field name="model">dental.tooth.record</field>
        <field name="inherit_id" ref="dental_charting_pro.view_dental_tooth_record_form"/>
        <field name="arch" type="xml">
            <!-- inject after the Clinical Notes group, before </sheet> -->
            <xpath expr="//sheet/group[last()]" position="after">
                <notebook>
                    <page string="Images / X-rays" name="page_images">
                        <field name="image_ids"
                               widget="many2many_binary"
                               string="Attached Images"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- ── Stat button on Tooth Record list (image count) ───────────────── -->
    <!-- Optional: image_count shown in the list view -->
    <record id="view_tooth_record_list_imaging" model="ir.ui.view">
        <field name="name">dental.tooth.record.list.imaging</field>
        <field name="model">dental.tooth.record</field>
        <field name="inherit_id" ref="dental_charting_pro.view_dental_tooth_record_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="image_count" string="Images" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
