<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- INSURER -->
    <record id="view_insurer_list" model="ir.ui.view">
        <field name="name">dental.insurer.list</field>
        <field name="model">dental.insurer</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="email"/>
                <field name="phone"/><field name="policy_count"/></list>
        </field>
    </record>
    <record id="view_insurer_form" model="ir.ui.view">
        <field name="name">dental.insurer.form</field>
        <field name="model">dental.insurer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><group>
                        <field name="name"/><field name="partner_id"/>
                        <field name="phone"/><field name="email"/>
                    </group><group>
                        <field name="website"/><field name="active"/>
                    </group></group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_insurer" model="ir.actions.act_window">
        <field name="name">Insurers</field><field name="res_model">dental.insurer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- POLICY -->
    <record id="view_policy_list" model="ir.ui.view">
        <field name="name">dental.policy.list</field>
        <field name="model">dental.policy</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="patient_id"/>
                <field name="insurer_id"/><field name="start_date"/>
                <field name="end_date"/><field name="coverage_pct"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'active'"
                    decoration-danger="state in ('expired','cancelled')"/>
            </list>
        </field>
    </record>
    <record id="view_policy_form" model="ir.ui.view">
        <field name="name">dental.policy.form</field>
        <field name="model">dental.policy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="active,expired,cancelled"/>
                </header>
                <sheet>
                    <group><group>
                        <field name="name"/><field name="patient_id"/>
                        <field name="insurer_id"/><field name="member_id"/>
                        <field name="group_number"/>
                    </group><group>
                        <field name="start_date"/><field name="end_date"/>
                        <field name="coverage_pct"/><field name="annual_max"/>
                    </group></group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_policy" model="ir.actions.act_window">
        <field name="name">Policies</field><field name="res_model">dental.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- CLAIM -->
    <record id="view_claim_list" model="ir.ui.view">
        <field name="name">dental.claim.list</field>
        <field name="model">dental.claim</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'"
                  decoration-success="state == 'paid'">
                <field name="name"/><field name="patient_id"/>
                <field name="insurer_id"/><field name="claim_date"/>
                <field name="total_amount"/><field name="approved_amount"/>
                <field name="patient_portion"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'paid'"
                    decoration-warning="state in ('submitted','pre_auth')"
                    decoration-danger="state == 'rejected'"
                    decoration-info="state == 'approved'"/>
            </list>
        </field>
    </record>
    <record id="view_claim_form" model="ir.ui.view">
        <field name="name">dental.claim.form</field>
        <field name="model">dental.claim</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                        invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_pre_auth" type="object" string="Pre-Authorise"
                        invisible="state != 'submitted'"/>
                    <button name="action_approve" type="object" string="Approve"
                        invisible="state not in ('submitted','pre_auth')"/>
                    <button name="action_reject" type="object" string="Reject"
                        invisible="state in ('rejected','paid')"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                        invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,pre_auth,approved,paid"/>
                </header>
                <sheet>
                    <group><group>
                        <field name="name" readonly="1"/><field name="patient_id"/>
                        <field name="policy_id"/><field name="insurer_id" readonly="1"/>
                        <field name="appointment_id"/>
                    </group><group>
                        <field name="claim_date"/>
                        <field name="total_amount"/><field name="approved_amount"/>
                        <field name="patient_portion" readonly="1"/>
                    </group></group>
                    <field name="treatment_ids" widget="many2many_tags"/>
                    <field name="rejection_reason"
                        invisible="state != 'rejected'" placeholder="Rejection reason..."/>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_claim" model="ir.actions.act_window">
        <field name="name">Claims</field><field name="res_model">dental.claim</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>