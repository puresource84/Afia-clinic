<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_dental" name="Portal My Home : Dental"
        inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Appointments</t>
                <t t-set="url">/my/appointments</t>
                <t t-set="count" t-value="appointment_count"/>
                <t t-set="icon" class="fa fa-calendar-plus-o"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Prescriptions</t>
                <t t-set="url">/my/prescriptions</t>
                <t t-set="count" t-value="prescription_count"/>
                <t t-set="icon" class="fa fa-medkit"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_appointments" name="My Appointments">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Appointments</t>
            </t>
            <t t-if="not appointments">
                <div class="alert alert-info mt-3">No appointments found.</div>
            </t>
            <t t-if="appointments">
                <div class="card mt-3">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ref</th><th>Date</th>
                                <th>Dentist</th><th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="appointments" t-as="apt">
                                <tr>
                                    <td t-out="apt.appointment_no"/>
                                    <td t-out="apt.appointment_date"/>
                                    <td t-out="apt.dentist_id.name"/>
                                    <td>
                                        <span class="badge bg-secondary" t-out="apt.state"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="portal_my_prescriptions" name="My Prescriptions">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Prescriptions</t>
            </t>
            <t t-if="not prescriptions">
                <div class="alert alert-info mt-3">No prescriptions found.</div>
            </t>
            <t t-if="prescriptions">
                <div class="card mt-3">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Date</th><th>Dentist</th><th>Diagnosis</th></tr>
                        </thead>
                        <tbody>
                            <t t-foreach="prescriptions" t-as="rx">
                                <tr>
                                    <td t-out="rx.create_date"/>
                                    <td t-out="rx.dentist_id.name"/>
                                    <td t-out="rx.diagnosis or ''"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>