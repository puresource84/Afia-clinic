<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── List view ────────────────────────────────────────────────────── -->
    <record id="view_perio_exam_list" model="ir.ui.view">
        <field name="name">dental.perio.exam.list</field>
        <field name="model">dental.perio.exam</field>
        <field name="arch" type="xml">
            <list string="Perio Exams"
                  decoration-muted="state == 'signed'"
                  decoration-info="state == 'draft'">
                <field name="exam_date"/>
                <field name="patient_id"/>
                <field name="dentist_id" optional="show"/>
                <field name="appointment_id" optional="show"/>
                <field name="bop_percent" string="BOP %"
                       widget="float" digits="[5,1]"/>
                <field name="avg_pd" string="Avg PD"
                       widget="float" digits="[5,1]"/>
                <field name="pocket_4_count" string="≥4 mm"/>
                <field name="pocket_6_count" string="≥6 mm"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'signed'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ─── Form view ────────────────────────────────────────────────────── -->
    <record id="view_perio_exam_form" model="ir.ui.view">
        <field name="name">dental.perio.exam.form</field>
        <field name="model">dental.perio.exam</field>
        <field name="arch" type="xml">
            <form string="Periodontal Examination">
                <header>
                    <button name="action_sign" type="object"
                            string="Sign Exam"
                            class="btn-primary"
                            invisible="state == 'signed'"
                            groups="clinic_core.group_clinic_dentist,clinic_core.group_clinic_admin,base.group_system"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"
                            groups="base.group_system"
                            confirm="Reset this signed perio exam to Draft?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,signed"/>
                </header>
                <sheet>
                    <!-- ── Title ──────────────────────────────────────── -->
                    <div class="oe_title">
                        <h2><field name="display_name" readonly="1"/></h2>
                    </div>

                    <!-- ── Visit info ──────────────────────────────────── -->
                    <group>
                        <group string="Patient">
                            <field name="patient_id"
                                   readonly="state == 'signed'"/>
                            <field name="dentist_id"
                                   readonly="state == 'signed'"/>
                        </group>
                        <group string="Visit">
                            <field name="exam_date"
                                   readonly="state == 'signed'"/>
                            <field name="appointment_id"
                                   readonly="state == 'signed'"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <!-- ── Summary stats + comparison ─────────────────── -->
                    <group string="Exam Summary">
                        <group string="This Exam">
                            <field name="bop_percent" string="BOP %"
                                   widget="float" digits="[5,1]"/>
                            <field name="avg_pd" string="Avg Pocket Depth (mm)"
                                   widget="float" digits="[5,1]"/>
                            <field name="pocket_4_count" string="Sites ≥ 4 mm"/>
                            <field name="pocket_6_count" string="Sites ≥ 6 mm"/>
                        </group>
                        <group string="Previous Exam Comparison"
                               invisible="not prev_exam_id">
                            <field name="prev_exam_id" readonly="1"
                                   options="{'no_open': False}"/>
                            <field name="prev_bop_percent" string="Prev BOP %"
                                   readonly="1" widget="float" digits="[5,1]"/>
                            <field name="prev_avg_pd" string="Prev Avg PD (mm)"
                                   readonly="1" widget="float" digits="[5,1]"/>
                        </group>
                    </group>

                    <!-- ── Perio chart — two arch tabs ─────────────────── -->
                    <notebook>
                        <!-- UPPER ARCH -->
                        <page string="Upper Arch (17 → 27)" name="page_upper">
                            <field name="upper_reading_ids"
                                   readonly="state == 'signed'"
                                   context="{'default_arch': 'upper', 'default_exam_id': id}">
                                <list editable="bottom"
                                      create="false" delete="false"
                                      decoration-danger="max_pd >= 6"
                                      decoration-warning="max_pd >= 4 and max_pd &lt; 6"
                                      decoration-muted="is_missing">
                                    <!-- Identity -->
                                    <field name="tooth_number" readonly="1" string="Tooth"/>
                                    <field name="is_missing" string="Miss."/>
                                    <field name="mobility" string="Mob"
                                           column_invisible="True"
                                           optional="show"/>
                                    <field name="furcation" string="Furc"
                                           optional="show"/>
                                    <!-- Buccal PD -->
                                    <field name="mb_pd"  string="MB" invisible="is_missing"/>
                                    <field name="b_pd"   string="B"  invisible="is_missing"/>
                                    <field name="db_pd"  string="DB" invisible="is_missing"/>
                                    <!-- Buccal Rec -->
                                    <field name="mb_rec" string="MB↑" optional="show" invisible="is_missing"/>
                                    <field name="b_rec"  string="B↑"  optional="show" invisible="is_missing"/>
                                    <field name="db_rec" string="DB↑" optional="show" invisible="is_missing"/>
                                    <!-- Buccal BOP -->
                                    <field name="mb_bop" string="MB●" invisible="is_missing"/>
                                    <field name="b_bop"  string="B●"  invisible="is_missing"/>
                                    <field name="db_bop" string="DB●" invisible="is_missing"/>
                                    <!-- Lingual PD -->
                                    <field name="ml_pd"  string="ML" invisible="is_missing"/>
                                    <field name="l_pd"   string="L"  invisible="is_missing"/>
                                    <field name="dl_pd"  string="DL" invisible="is_missing"/>
                                    <!-- Lingual Rec -->
                                    <field name="ml_rec" string="ML↑" optional="show" invisible="is_missing"/>
                                    <field name="l_rec"  string="L↑"  optional="show" invisible="is_missing"/>
                                    <field name="dl_rec" string="DL↑" optional="show" invisible="is_missing"/>
                                    <!-- Lingual BOP -->
                                    <field name="ml_bop" string="ML●" invisible="is_missing"/>
                                    <field name="l_bop"  string="L●"  invisible="is_missing"/>
                                    <field name="dl_bop" string="DL●" invisible="is_missing"/>
                                    <!-- Summary -->
                                    <field name="max_pd"    string="Max" readonly="1"/>
                                    <field name="bop_count" string="BOP#" readonly="1"/>
                                    <field name="arch" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <!-- LOWER ARCH -->
                        <page string="Lower Arch (47 → 31)" name="page_lower">
                            <field name="lower_reading_ids"
                                   readonly="state == 'signed'"
                                   context="{'default_arch': 'lower', 'default_exam_id': id}">
                                <list editable="bottom"
                                      create="false" delete="false"
                                      decoration-danger="max_pd >= 6"
                                      decoration-warning="max_pd >= 4 and max_pd &lt; 6"
                                      decoration-muted="is_missing">
                                    <field name="tooth_number" readonly="1" string="Tooth"/>
                                    <field name="is_missing" string="Miss."/>
                                    <field name="furcation" string="Furc" optional="show"/>
                                    <field name="mb_pd"  string="MB" invisible="is_missing"/>
                                    <field name="b_pd"   string="B"  invisible="is_missing"/>
                                    <field name="db_pd"  string="DB" invisible="is_missing"/>
                                    <field name="mb_rec" string="MB↑" optional="show" invisible="is_missing"/>
                                    <field name="b_rec"  string="B↑"  optional="show" invisible="is_missing"/>
                                    <field name="db_rec" string="DB↑" optional="show" invisible="is_missing"/>
                                    <field name="mb_bop" string="MB●" invisible="is_missing"/>
                                    <field name="b_bop"  string="B●"  invisible="is_missing"/>
                                    <field name="db_bop" string="DB●" invisible="is_missing"/>
                                    <field name="ml_pd"  string="ML" invisible="is_missing"/>
                                    <field name="l_pd"   string="L"  invisible="is_missing"/>
                                    <field name="dl_pd"  string="DL" invisible="is_missing"/>
                                    <field name="ml_rec" string="ML↑" optional="show" invisible="is_missing"/>
                                    <field name="l_rec"  string="L↑"  optional="show" invisible="is_missing"/>
                                    <field name="dl_rec" string="DL↑" optional="show" invisible="is_missing"/>
                                    <field name="ml_bop" string="ML●" invisible="is_missing"/>
                                    <field name="l_bop"  string="L●"  invisible="is_missing"/>
                                    <field name="dl_bop" string="DL●" invisible="is_missing"/>
                                    <field name="max_pd"    string="Max" readonly="1"/>
                                    <field name="bop_count" string="BOP#" readonly="1"/>
                                    <field name="arch" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <!-- NOTES -->
                        <page string="Clinical Notes" name="page_notes">
                            <field name="notes"
                                   placeholder="Diagnosis, treatment plan, referral notes…"
                                   readonly="state == 'signed'"/>
                            <group string="Signature" invisible="state == 'draft'">
                                <field name="signed_by" readonly="1"/>
                                <field name="signed_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── Search view ──────────────────────────────────────────────────── -->
    <record id="view_perio_exam_search" model="ir.ui.view">
        <field name="name">dental.perio.exam.search</field>
        <field name="model">dental.perio.exam</field>
        <field name="arch" type="xml">
            <search string="Perio Exams">
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Signed" name="filter_signed"
                        domain="[('state', '=', 'signed')]"/>
                <separator/>
                <filter string="High BOP (≥ 30%)" name="filter_high_bop"
                        domain="[('bop_percent', '>=', 30)]"/>
                <filter string="Deep Pockets (has ≥ 6mm)" name="filter_deep"
                        domain="[('pocket_6_count', '>', 0)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Patient" name="group_patient"
                            context="{'group_by': 'patient_id'}"/>
                    <filter string="Dentist" name="group_dentist"
                            context="{'group_by': 'dentist_id'}"/>
                    <filter string="Exam Month" name="group_month"
                            context="{'group_by': 'exam_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Window action ────────────────────────────────────────────────── -->
    <record id="action_perio_exams" model="ir.actions.act_window">
        <field name="name">Perio Exams</field>
        <field name="res_model">dental.perio.exam</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No periodontal exams yet.</p>
            <p>Open an appointment and click <b>Perio</b> to start a new exam,
               or create one here and link it to a patient.</p>
        </field>
    </record>

    <!-- ─── Menu item under Dental Clinic ───────────────────────────────── -->
    <menuitem id="menu_perio_exams"
              name="Perio Exams"
              parent="afia_dental_core.hospital_root_menu"
              action="action_perio_exams"
              sequence="16"
              groups="clinic_core.group_clinic_admin,clinic_core.group_clinic_dentist"/>

</odoo>
