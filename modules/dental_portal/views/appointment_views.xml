<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reception: show the booked 30-min slot next to the shift -->
    <record id="view_appointment_form_slot" model="ir.ui.view">
        <field name="name">dental.appointment.form.slot</field>
        <field name="model">dental.appointment</field>
        <field name="inherit_id" ref="afia_dental_core.view_dental_appointment_form"/>
        <field name="arch" type="xml">
            <field name="shift_id" position="after">
                <field name="booking_slot" widget="float_time"
                       invisible="not booking_slot"/>
            </field>
        </field>
    </record>

</odoo>
