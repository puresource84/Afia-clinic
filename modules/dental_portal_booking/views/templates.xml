<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branding fix (2026-06-14): switched from website.layout (CMS, shows "Your Logo"
         placeholder when no website logo is uploaded) to portal.portal_layout which
         renders the company logo from res.company — always shows the real clinic name/logo. -->
    <template id="booking_page" name="Book Dental Appointment">
        <t t-call="portal.portal_layout">
            <t t-set="title" t-value="'Book a Dental Appointment'"/>
            <div class="container mt-5 mb-5">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <h2 class="mb-4">Book a Dental Appointment</h2>
                        <t t-if="error">
                            <div class="alert alert-danger" t-out="error"/>
                        </t>
                        <form action="/dental/book/submit" method="post" class="row g-3">
                            <input type="hidden" name="csrf_token"
                                t-att-value="request.csrf_token()"/>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Full Name *</label>
                                <input type="text" name="patient_name"
                                    class="form-control" required="required"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Mobile</label>
                                <input type="text" name="patient_mobile" class="form-control"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Preferred Date *</label>
                                <input type="date" name="appointment_date"
                                    class="form-control" required="required"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Preferred Dentist</label>
                                <select name="dentist_id" class="form-select">
                                    <option value="">-- Any Available --</option>
                                    <t t-foreach="dentists" t-as="d">
                                        <option t-att-value="d.id" t-out="d.name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Notes / Chief Complaint</label>
                                <textarea name="patient_notes" class="form-control" rows="3"/>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    Request Appointment
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="booking_success" name="Booking Confirmed">
        <t t-call="portal.portal_layout">
            <t t-set="title" t-value="'Appointment Request Received'"/>
            <div class="container mt-5 text-center">
                <i class="fa fa-check-circle fa-5x text-success mb-3"/>
                <h2>Appointment Request Received!</h2>
                <p class="lead">Thank you. We will contact you shortly to confirm your appointment.</p>
                <a href="/dental/book" class="btn btn-primary mt-3">Book Another</a>
            </div>
        </t>
    </template>
</odoo>
