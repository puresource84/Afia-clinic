<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_telegram_reminders" model="ir.cron">
            <field name="name">Dental: Telegram Appointment Reminders</field>
            <field name="model_id" ref="dental_hospital.model_dental_appointment"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_telegram_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_telegram_poll_updates" model="ir.cron">
            <field name="name">Dental: Telegram Patient Linking (poll)</field>
            <field name="model_id" ref="dental_hospital.model_dental_appointment"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_telegram_updates()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_telegram_reviews" model="ir.cron">
            <field name="name">Dental: Telegram Review Requests</field>
            <field name="model_id" ref="dental_hospital.model_dental_appointment"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_review_requests()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_telegram_recalls" model="ir.cron">
            <field name="name">Dental: Telegram Recall Campaign</field>
            <field name="model_id" ref="dental_hospital.model_dental_appointment"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_telegram_recalls()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
