<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Printable patient card: QR deep link to the clinic Telegram bot.
         Print menu on the patient form > "Telegram Reminder Card". -->

    <template id="report_telegram_card">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="link" t-value="o._tg_deep_link()"/>
                <div class="page" style="page-break-after: always; font-family: sans-serif;">
                    <div style="border: 2px solid #0e7c7b; border-radius: 14px; max-width: 420px; margin: 20px auto; padding: 22px; text-align: center;">
                        <h3 style="color:#0e7c7b; margin: 0 0 4px;" t-esc="o.env.company.name"/>
                        <p style="margin: 0 0 12px; color:#555;">
                            بطاقة تذكيرات المواعيد — تيليجرام<br/>
                            Appointment Reminders Card — Telegram
                        </p>
                        <strong t-esc="o.name"/>
                        <div style="color:#777; margin-bottom: 12px;" t-esc="o.patient_no"/>
                        <img t-att-src="'/report/barcode/?barcode_type=QR&amp;width=180&amp;height=180&amp;value=' + quote_plus(link)"
                             style="width:180px; height:180px;"/>
                        <p style="font-size: 12px; color:#555; margin-top: 10px;">
                            امسح الرمز وافتح المحادثة ثم اضغط START لتصلك تذكيرات
                            مواعيدك تلقائياً على تيليجرام.<br/>
                            Scan the code, open the chat and press START to receive
                            your appointment reminders on Telegram.
                        </p>
                        <div style="font-size: 11px; color:#999;" t-esc="link"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_telegram_card" model="ir.actions.report">
        <field name="name">Telegram Reminder Card</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dental_reminders_telegram.report_telegram_card</field>
        <field name="report_file">dental_reminders_telegram.report_telegram_card</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Telegram Card - %s' % (object.name)</field>
    </record>
</odoo>
