<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Telegram settings live inside the Clinic Core section of the
         Settings page (Manhel, 2026-06-11). -->
    <record id="res_config_settings_view_form_tg" model="ir.ui.view">
        <field name="name">res.config.settings.form.dental.telegram</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="clinic_core.view_clinic_core_res_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='clinic_core']" position="inside">
                <block title="Telegram">
                    <setting string="Enable Telegram"
                             help="Automated appointment reminders and patient self-linking through the clinic's Telegram bot">
                        <field name="dental_tg_enabled"/>
                    </setting>
                    <setting string="Bot Token"
                             help="From @BotFather (e.g. 123456:ABC-DEF...)"
                             invisible="not dental_tg_enabled">
                        <field name="dental_tg_bot_token" password="True"/>
                    </setting>
                    <setting string="Bot Username"
                             help="Without @. Patient deep link: t.me/&lt;bot&gt;?start=&lt;PatientNo&gt;"
                             invisible="not dental_tg_enabled">
                        <field name="dental_tg_bot_username"/>
                    </setting>
                    <setting string="Recall After (months)"
                             help="Hygiene recall interval, auto-set when an appointment is Done"
                             invisible="not dental_tg_enabled">
                        <field name="dental_tg_recall_months"/>
                    </setting>
                    <setting string="Google Review Link"
                             help="Sent to patients who rate their visit 5/5"
                             invisible="not dental_tg_enabled">
                        <field name="dental_tg_review_link"/>
                    </setting>
                    <setting string="Clinic Timezone"
                             help="Used for reminder/recall date calculations (e.g. Asia/Baghdad)"
                             invisible="not dental_tg_enabled">
                        <field name="dental_tg_clinic_tz"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Dental app > Configure > Telegram Settings -->
    <record id="action_telegram_settings" model="ir.actions.act_window">
        <field name="name">Telegram Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'clinic_core'}</field>
    </record>

    <menuitem id="menu_telegram_settings"
              name="Telegram Settings"
              parent="afia_dental_core.dental_configure"
              action="action_telegram_settings"
              sequence="100"/>
</odoo>
