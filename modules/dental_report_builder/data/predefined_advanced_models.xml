<odoo>
    <!-- NEW: Advanced Model for Upcoming Appointments -->
    <record id="dental_report_advanced_model_upcoming_appointments" model="dental.report.advanced.model">
        <field name="name">Upcoming Appointments</field>
        <field name="base_model_id" search="[('model_id.model','=','dental.appointment')]" />
    </record>

    <!-- NEW: Advanced Model for Patients by Treatment -->
    <record id="dental_report_advanced_model_patients_by_treatment" model="dental.report.advanced.model">
        <field name="name">Patients by Treatment</field>
        <field name="base_model_id" search="[('model_id.model','=','dental.treatment')]" />
    </record>
</odoo>
