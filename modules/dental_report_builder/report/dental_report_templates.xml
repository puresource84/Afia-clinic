<odoo>
    <template id="report_upcoming_appointments" inherit_id="web.external_layout">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Upcoming Appointments</h2>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Dentist</th>
                            <th>Service</th>
                            <th>Appointment Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="appt">
                            <tr>
                                <td><t t-esc="appt.patient_name"/></td>
                                <td><t t-esc="appt.dentist_name"/></td>
                                <td><t t-esc="appt.service_name"/></td>
                                <td><t t-esc="appt.date"/></td>
                                <td><t t-esc="appt.status"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_patients_by_treatment" inherit_id="web.external_layout">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Patients by Treatment</h2>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Treatment Name</th>
                            <th>Dentist</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="tx">
                            <tr>
                                <td><t t-esc="tx.patient_name"/></td>
                                <td><t t-esc="tx.treatment_name"/></td>
                                <td><t t-esc="tx.dentist_name"/></td>
                                <td><t t-esc="tx.start_date"/></td>
                                <td><t t-esc="tx.end_date"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
