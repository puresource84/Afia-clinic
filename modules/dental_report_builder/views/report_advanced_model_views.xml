<odoo>
    <record id="view_report_advanced_model_form" model="ir.ui.view">
        <field name="name">report.advanced.model.form</field>
        <field name="model">dental.report.advanced.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="base_model_id"/>
                    </group>
                    <notebook>
                        <page string="Filters">
                            <field name="filter_ids">
                                <tree editable="bottom">
                                    <field name="field_name"/>
                                    <field name="operator"/>
                                    <field name="value"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_report_advanced_model_tree" model="ir.ui.view">
        <field name="name">report.advanced.model.tree</field>
        <field name="model">dental.report.advanced.model</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="base_model_id"/>
            </tree>
        </field>
    </record>

    <record id="action_report_advanced_model" model="ir.actions.act_window">
        <field name="name">Advanced Models</field>
        <field name="res_model">dental.report.advanced.model</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_dental_report_advanced_model"
              name="Advanced Models"
              parent="menu_dental_report_models"
              action="action_report_advanced_model"/>
</odoo>
