<odoo>
    <record id="view_report_base_model_form" model="ir.ui.view">
        <field name="name">report.base.model.form</field>
        <field name="model">dental.report.base.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="field_description"/>
                    </group>
                    <notebook>
                        <page string="Columns">
                            <field name="column_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="field_description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_report_base_model_tree" model="ir.ui.view">
        <field name="name">report.base.model.list</field>
        <field name="model">dental.report.base.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
            </list>
        </field>
    </record>

    <record id="action_report_base_model" model="ir.actions.act_window">
        <field name="name">Base Models</field>
        <field name="res_model">dental.report.base.model</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_dental_report_base_model"
              name="Base Models"
              parent="menu_dental_report_models"
              action="action_report_base_model"/>
</odoo>
