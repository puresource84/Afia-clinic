<odoo>
    <!-- Tree View for Report Instances -->
    <record id="view_dental_report_instance_tree" model="ir.ui.view">
        <field name="name">dental.report.instance.tree</field>
        <field name="model">dental.report.instance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="advanced_model_id"/>
                <field name="generated_at"/>
            </tree>
        </field>
    </record>

    <!-- Form View with Button -->
    <record id="view_dental_report_instance_form" model="ir.ui.view">
        <field name="name">dental.report.instance.form</field>
        <field name="model">dental.report.instance</field>
        <field name="arch" type="xml">
            <form>
                <!-- NEW: Add a button to trigger report generation -->
                <header>
                    <button name="action_generate_report"
                            type="object"
                            class="btn-primary"
                            string="Generate Report"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="advanced_model_id"/>
                        <field name="generated_at" readonly="1"/>
                        <field name="result_data" readonly="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_dental_report_instance" model="ir.actions.act_window">
        <field name="name">Generated Reports</field>
        <field name="res_model">dental.report.instance</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_dental_report_instances_sub"
              name="View Reports"
              parent="menu_dental_report_instances"
              action="action_dental_report_instance"/>
</odoo>
