<odoo>
    <record id="view_report_table_mapping_form" model="ir.ui.view">
        <field name="name">report.table.mapping.form</field>
        <field name="model">dental.report.table.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="base_model_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_report_table_mapping_tree" model="ir.ui.view">
        <field name="name">report.table.mapping.tree</field>
        <field name="model">dental.report.table.mapping</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="base_model_ids"/>
            </tree>
        </field>
    </record>

    <record id="action_report_table_mapping" model="ir.actions.act_window">
        <field name="name">Table Mappings</field>
        <field name="res_model">dental.report.table.mapping</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_dental_report_table_mapping"
              name="Table Mappings"
              parent="menu_dental_report_models"
              action="action_report_table_mapping"/>
</odoo>
