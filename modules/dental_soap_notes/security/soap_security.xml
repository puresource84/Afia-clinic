<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Signed notes are read-only for non-admins.
         Record rule: dentists and hygienists can only write DRAFT notes.
         Hygienist added 2026-07-24 alongside their new SOAP CSV access —
         must stay in lockstep with that grant, otherwise a hygienist with
         plain write=1 access would have NO domain restriction at all and
         could edit signed/finalized notes, which is worse than not having
         access. -->
    <record id="rule_soap_note_dentist_draft_only" model="ir.rule">
        <field name="name">SOAP Note: dentists and hygienists write draft only</field>
        <field name="model_id" ref="model_dental_soap_note"/>
        <field name="domain_force">[('state', '=', 'draft')]</field>
        <field name="groups" eval="[
            (4, ref('afia_dental_core.group_clinic_dentist')),
            (4, ref('afia_dental_core.group_clinic_hygienist')),
        ]"/>
        <field name="perm_read">0</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
