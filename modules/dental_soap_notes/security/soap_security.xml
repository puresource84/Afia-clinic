<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Signed notes are read-only for non-admins.
         Record rule: dentists can only write DRAFT notes. -->
    <record id="rule_soap_note_dentist_draft_only" model="ir.rule">
        <field name="name">SOAP Note: dentists write draft only</field>
        <field name="model_id" ref="model_dental_soap_note"/>
        <field name="domain_force">[('state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('clinic_core.group_clinic_dentist'))]"/>
        <field name="perm_read">0</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
