<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inject Clinical Notes stat button into the existing button_box -->
    <record id="view_appointment_soap_button" model="ir.ui.view">
        <field name="name">dental.appointment.form.soap.button</field>
        <field name="model">dental.appointment</field>
        <field name="inherit_id" ref="afia_dental_core.view_dental_appointment_form"/>
        <!-- No priority needed: afia_dental_core declares the button_box. -->
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_soap_notes" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        groups="afia_dental_core.group_clinic_admin,afia_dental_core.group_clinic_dentist,afia_dental_core.group_clinic_receptionist,afia_dental_core.group_clinic_hygienist">
                    <field name="soap_note_count" widget="statinfo"
                           string="Clinical Notes"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
