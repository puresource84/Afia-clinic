<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_soap_template_list" model="ir.ui.view">
        <field name="name">dental.soap.template.list</field>
        <field name="model">dental.soap.template</field>
        <field name="arch" type="xml">
            <list string="SOAP Templates">
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="cdt_codes" optional="show"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_soap_template_form" model="ir.ui.view">
        <field name="name">dental.soap.template.form</field>
        <field name="model">dental.soap.template</field>
        <field name="groups_id" eval="[(4, ref('afia_dental_core.group_clinic_admin'))]"/>
        <field name="arch" type="xml">
            <form string="SOAP Note Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Procedure name (e.g. Extraction, RCT)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="cdt_codes" placeholder="D7140, D0220"/>
                        </group>
                        <group>
                            <field name="chief_complaint"
                                   placeholder="Default chief complaint for this procedure"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <!-- ── Content library sentences per section ────────── -->
                    <!-- groups on each field: only admin can edit sentences here -->
                    <notebook>
                        <page string="S — Subjective" name="page_s">
                            <field name="s_sentence_ids"
                                   groups="afia_dental_core.group_clinic_admin"
                                   context="{'default_section': 'S',
                                             'default_template_id': id}">
                                <list editable="bottom" create="true" delete="true">
                                    <field name="sequence" widget="handle"/>
                                    <field name="text" string="Phrase / Sentence"
                                           placeholder="Add a new subjective phrase…"/>
                                    <field name="active" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="O — Objective" name="page_o">
                            <field name="o_sentence_ids"
                                   groups="afia_dental_core.group_clinic_admin"
                                   context="{'default_section': 'O',
                                             'default_template_id': id}">
                                <list editable="bottom" create="true" delete="true">
                                    <field name="sequence" widget="handle"/>
                                    <field name="text" string="Phrase / Sentence"
                                           placeholder="Add a new objective finding…"/>
                                    <field name="active" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="A — Assessment" name="page_a">
                            <field name="a_sentence_ids"
                                   groups="afia_dental_core.group_clinic_admin"
                                   context="{'default_section': 'A',
                                             'default_template_id': id}">
                                <list editable="bottom" create="true" delete="true">
                                    <field name="sequence" widget="handle"/>
                                    <field name="text" string="Phrase / Sentence"
                                           placeholder="Add a new assessment / diagnosis…"/>
                                    <field name="active" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="P — Plan" name="page_p">
                            <field name="p_sentence_ids"
                                   groups="afia_dental_core.group_clinic_admin"
                                   context="{'default_section': 'P',
                                             'default_template_id': id}">
                                <list editable="bottom" create="true" delete="true">
                                    <field name="sequence" widget="handle"/>
                                    <field name="text" string="Phrase / Sentence"
                                           placeholder="Add a new plan / treatment entry…"/>
                                    <field name="active" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_soap_templates" model="ir.actions.act_window">
        <field name="name">SOAP Templates</field>
        <field name="res_model">dental.soap.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_soap_templates"
              name="SOAP Note Templates"
              parent="afia_dental_core.dental_configure"
              action="action_soap_templates"
              sequence="55"
              groups="afia_dental_core.group_clinic_admin"/>

</odoo>
