<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_steril_list" model="ir.ui.view">
        <field name="name">dental.sterilization.log.list</field>
        <field name="model">dental.sterilization.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'fail'"
                  decoration-success="state == 'pass'"
                  decoration-warning="state == 'pending'">
                <field name="name"/>
                <field name="cycle_date"/>
                <field name="instrument_set"/>
                <field name="cycle_type"/>
                <field name="autoclave_id"/>
                <field name="operator_id"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'pass'"
                    decoration-danger="state == 'fail'"
                    decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_steril_form" model="ir.ui.view">
        <field name="name">dental.sterilization.log.form</field>
        <field name="model">dental.sterilization.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pass" type="object" string="Mark PASS"
                        invisible="state != 'pending'" class="btn-success"/>
                    <button name="action_fail" type="object" string="Mark FAIL"
                        invisible="state != 'pending'" class="btn-danger"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="pending,pass,fail"/>
                </header>
                <sheet>
                    <group><group>
                        <field name="name" readonly="1"/>
                        <field name="cycle_date"/>
                        <field name="operator_id"/>
                        <field name="instrument_set"/>
                        <field name="autoclave_id"/>
                    </group><group>
                        <field name="cycle_type"/>
                        <field name="temperature"/>
                        <field name="pressure"/>
                        <field name="duration_min"/>
                        <field name="load_number"/>
                        <field name="biological_indicator"/>
                        <field name="expiry_date" readonly="1"/>
                    </group></group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_steril_log" model="ir.actions.act_window">
        <field name="name">Sterilization Logs</field>
        <field name="res_model">dental.sterilization.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>