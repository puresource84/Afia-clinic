<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_treatment_plan_proposal" model="ir.actions.report">
        <field name="name">Treatment Plan Proposal</field>
        <field name="model">dental.treatment.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dental_treatment_plan.report_treatment_plan_proposal</field>
        <field name="report_file">dental_treatment_plan.report_treatment_plan_proposal</field>
        <field name="print_report_name">'Treatment Plan - %s' % (object.name)</field>
        <field name="binding_model_id" ref="dental_treatment_plan.model_dental_treatment_plan"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_treatment_plan_proposal">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Treatment Plan <span t-field="doc.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Patient:</strong> <span t-field="doc.patient_id"/><br/>
                                <strong>Dentist:</strong> <span t-field="doc.dentist_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Date Presented:</strong>
                                <span t-field="doc.presented_date" t-options='{"widget": "date"}'/><br/>
                                <strong>Status:</strong> <span t-field="doc.state"/>
                            </div>
                        </div>
                        <t t-if="doc.diagnosis">
                            <h5 class="mt-3">Diagnosis</h5>
                            <p t-field="doc.diagnosis"/>
                        </t>
                        <h5 class="mt-3">Proposed Sessions</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Session</th>
                                    <th>Treatments</th>
                                    <th>Planned Date</th>
                                    <th class="text-end">Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><span t-esc="line_index + 1"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td><span t-esc="', '.join(line.treatment_ids.mapped('display_name'))"/></td>
                                    <td><span t-field="line.scheduled_date"/></td>
                                    <td class="text-end"><span t-field="line.cost"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-end"><strong>Total</strong></td>
                                    <td class="text-end"><strong t-field="doc.total_cost"/></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="row mt-5">
                            <div class="col-6">
                                <strong>Patient acceptance</strong><br/>
                                <t t-if="doc.patient_signature">
                                    <img t-att-src="image_data_uri(doc.patient_signature)"
                                         style="max-height: 80px;"/>
                                    <br/>
                                    <span t-field="doc.accepted_by"/> —
                                    <span t-field="doc.accepted_date" t-options='{"widget": "date"}'/>
                                </t>
                                <t t-else="">
                                    <div style="border-bottom: 1px solid #000; height: 60px; width: 80%;"/>
                                    <span>Name &amp; signature / الاسم والتوقيع</span>
                                </t>
                            </div>
                            <div class="col-6">
                                <strong>Dentist</strong><br/>
                                <div style="height: 60px;"/>
                                <span t-field="doc.dentist_id"/>
                            </div>
                        </div>
                        <p class="text-muted small mt-4">
                            Prices are estimates; final charges may vary with clinical findings.
                            الأسعار تقديرية وقد تتغير حسب المعطيات السريرية.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
