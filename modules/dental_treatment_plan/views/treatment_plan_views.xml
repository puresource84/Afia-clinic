<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treatment_plan_list" model="ir.ui.view">
        <field name="name">dental.treatment.plan.list</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <list string="Treatment Plans">
                <field name="name"/><field name="patient_id"/>
                <field name="dentist_id"/><field name="total_sessions"/>
                <field name="completed_sessions"/>
                <field name="progress_pct" widget="progressbar"/>
                <field name="total_cost"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'completed'"
                    decoration-info="state == 'in_progress'"
                    decoration-muted="state in ('draft','cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_treatment_plan_form" model="ir.ui.view">
        <field name="name">dental.treatment.plan.form</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start Plan"
                        invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_complete" type="object" string="Mark Complete"
                        invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state in ('completed','cancelled')"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <group><group>
                        <field name="name" readonly="1"/>
                        <field name="patient_id"/>
                        <field name="dentist_id"/>
                    </group><group>
                        <field name="total_sessions"/>
                        <field name="completed_sessions"/>
                        <field name="progress_pct" widget="progressbar"/>
                        <field name="total_cost"/>
                    </group></group>
                    <field name="diagnosis" placeholder="Diagnosis / Chief Complaint..."/>
                    <notebook>
                        <page name="sessions" string="Sessions">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="treatment_ids" widget="many2many_tags"/>
                                    <field name="scheduled_date"/>
                                    <field name="cost"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_treatment_plan" model="ir.actions.act_window">
        <field name="name">Treatment Plans</field>
        <field name="res_model">dental.treatment.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>