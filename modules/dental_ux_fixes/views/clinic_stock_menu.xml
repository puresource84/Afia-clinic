<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Clinic Stock — full CRUD view inside Afia Clinic app ──────────────
         Design intent (2026-06-14 redesign):
           • Staff can ADD new consumable products without going to Inventory app
           • Staff can EDIT product details (name, category, cost, UOM)
           • Stock quantity is read-only on the list; use "Adjust Stock" button
             on the form to do an inventory adjustment via Odoo's native wizard
           • is_clinic_consumable is now a STORED Boolean (not computed) so
             products can be flagged manually or auto-flagged when added to a
             treatment BOM (dental_consumables handles the auto-flag).
           • On create from this view, is_clinic_consumable is auto-set to True
             via the action context default.
           • Admin only: can delete (set active=False on the product)

         dental_consumables must be installed (provides is_clinic_consumable field).
    ──────────────────────────────────────────────────────────────────────── -->

    <!-- Hide dental_consumables' duplicate "Clinic Stock" menu (seq=50) -->
    <record id="dental_consumables.menu_clinic_stock" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- ── Simplified form view for a clinic consumable ───────────────────── -->
    <record id="view_clinic_consumable_form_ux" model="ir.ui.view">
        <field name="name">clinic.consumable.product.form.ux</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form string="Clinic Consumable">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Opens Odoo's native inventory adjustment wizard -->
                        <button name="action_update_quantity_on_hand"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes"
                                groups="afia_dental_core.group_clinic_admin">
                            <field name="qty_available" widget="statinfo"
                                   string="On Hand"/>
                        </button>
                        <button name="action_update_quantity_on_hand"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes"
                                groups="!afia_dental_core.group_clinic_admin">
                            <field name="qty_available" widget="statinfo"
                                   string="On Hand" readonly="1"/>
                        </button>
                    </div>

                    <field name="image_1920" widget="image"
                           class="oe_avatar" optional="show"/>
                    <div class="oe_title">
                        <label for="name" string="Material Name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Examination Gloves (S)"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Details">
                            <field name="default_code" string="Internal Ref"/>
                            <field name="categ_id" string="Category"/>
                            <field name="uom_id" string="Unit of Measure"/>
                            <field name="type" string="Product Type"/>
                            <field name="is_clinic_consumable"
                                   string="Clinic Consumable"
                                   readonly="1"/>
                        </group>
                        <group string="Pricing &amp; Stock">
                            <field name="standard_price" string="Unit Cost (IQD)"/>
                            <field name="qty_available" string="On Hand" readonly="1"/>
                            <field name="virtual_available" string="Forecasted" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── List view: colour-coded by stock level ─────────────────────────── -->
    <record id="view_clinic_stock_product_list_ux" model="ir.ui.view">
        <field name="name">clinic.stock.product.list.ux</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Clinic Stock"
                  decoration-danger="qty_available &lt;= 0"
                  decoration-warning="qty_available &gt; 0 and qty_available &lt;= 5">
                <field name="name" string="Material"/>
                <field name="default_code" string="Ref" optional="hide"/>
                <field name="categ_id" string="Category" optional="show"/>
                <field name="uom_id" string="Unit"/>
                <field name="qty_available" string="On Hand" readonly="1"/>
                <field name="virtual_available" string="Forecasted" optional="show" readonly="1"/>
                <field name="standard_price" string="Unit Cost" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Search: low-stock filters + category grouping ─────────────────── -->
    <record id="view_clinic_stock_search_ux" model="ir.ui.view">
        <field name="name">clinic.stock.product.search.ux</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Clinic Stock">
                <field name="name" string="Material"/>
                <field name="default_code" string="Reference"/>
                <field name="categ_id" string="Category"/>
                <filter string="Out of Stock"
                        name="filter_out_of_stock"
                        domain="[('qty_available', '&lt;=', 0)]"/>
                <filter string="Low Stock (≤ 5)"
                        name="filter_low_stock"
                        domain="[('qty_available', '&lt;=', 5),
                                 ('qty_available', '&gt;', 0)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window action ──────────────────────────────────────────────────── -->
    <record id="action_clinic_stock_ux" model="ir.actions.act_window">
        <field name="name">Clinic Stock</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_clinic_consumable', '=', True)]</field>
        <!-- default_is_clinic_consumable: new products created here are auto-flagged -->
        <field name="context">{
            'default_is_clinic_consumable': True,
            'default_type': 'consu'
        }</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list',
                    'view_id': ref('view_clinic_stock_product_list_ux')}),
            (0, 0, {'view_mode': 'form',
                    'view_id': ref('view_clinic_consumable_form_ux')}),
        ]"/>
        <field name="search_view_id" ref="view_clinic_stock_search_ux"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No clinic consumables yet.
            </p>
            <p>
                Click <b>New</b> to add a supply item (gloves, composite, anesthetic…),
                or add materials under <b>Configure → Treatments → Consumed Materials</b>
                to have them appear here automatically.
            </p>
        </field>
    </record>

    <!-- ── Menu item ──────────────────────────────────────────────────────── -->
    <menuitem id="menu_clinic_stock_ux"
              name="Clinic Stock"
              parent="afia_dental_core.hospital_root_menu"
              action="action_clinic_stock_ux"
              sequence="45"
              groups="afia_dental_core.group_clinic_admin,afia_dental_core.group_clinic_dentist,afia_dental_core.group_clinic_receptionist"/>

</odoo>
