<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_afia_license_banner" model="ir.ui.view">
        <field name="name">hr.employee.form.afia.license.banner</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-success mb-0" role="alert"
                     invisible="afia_dentist_banner_type != 'ok'">
                    <field name="afia_dentist_banner_text" readonly="1"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="afia_dentist_banner_type != 'warning'">
                    <field name="afia_dentist_banner_text" readonly="1"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="afia_dentist_banner_type != 'danger'">
                    <field name="afia_dentist_banner_text" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
