<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_afia_license_banner" model="ir.ui.view">
        <field name="name">res.partner.form.afia.license.banner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="afia_dental_core.view_partner_form_dental"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-success mb-0" role="alert"
                     invisible="not is_patient or afia_patient_banner_type != 'ok'">
                    <field name="afia_patient_banner_text" readonly="1"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not is_patient or afia_patient_banner_type != 'warning'">
                    <field name="afia_patient_banner_text" readonly="1"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="not is_patient or afia_patient_banner_type != 'danger'">
                    <field name="afia_patient_banner_text" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_patient_list_afia_license_banner" model="ir.ui.view">
        <field name="name">res.partner.list.afia.license.banner</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Patients" banner_route="/itcs_license/patients_banner">
                <field name="patient_no"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="gender"/>
                <field name="patient_age"/>
            </list>
        </field>
    </record>

    <!-- Partial override: add the banner list view to the existing Patients
         menu action from afia_dental_core, without touching that module's
         own file. Form view stays the standard dental partner form. -->
    <record id="afia_dental_core.dental_patient_menu" model="ir.actions.act_window">
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_patient_list_afia_license_banner')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('afia_dental_core.view_partner_form_dental')}),
        ]"/>
    </record>
</odoo>
