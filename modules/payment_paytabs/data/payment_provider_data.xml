<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Bootstrap a PayTabs provider record.
        noupdate="1" preserves live credential edits from being overwritten on upgrade.
    -->
    <record id="payment_provider_paytabs" model="payment.provider">
        <field name="name">PayTabs</field>
        <field name="code">paytabs</field>
        <field name="state">disabled</field>
        <field name="is_published">False</field>
        <field name="allow_tokenization">False</field>
        <field name="support_refund">none</field>
        <!-- MENA endpoint — correct for Iraq merchants -->
        <field name="paytabs_region">https://secure.paytabs.sa</field>
    </record>

</odoo>
